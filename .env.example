# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG CHO HỆ THỐNG SYS-AIR (NEXT.JS + MONGODB)
# Sao chép file này thành .env trên máy mới trước khi chạy dự án:
#    cp .env.example .env (hoặc copy .env.example .env trên Windows)
# ==============================================================================

# 1. Kết nối Cơ sở dữ liệu MongoDB (Bắt buộc)
# Chạy MongoDB cục bộ (Local) hoặc MongoDB Atlas Cloud:
MONGODB_URI=mongodb://localhost:27017/sys-air
MongoDB_URI=mongodb://localhost:27017/sys-air

# 2. Cấu hình Bảo mật JWT & Cookie (Bắt buộc)
JWT_SECRET=air_super_secret_jwt_key_2026_change_in_production
TOKEN_COOKIE_NAME=token
token=token

# 3. Địa chỉ URL chạy ứng dụng (Bắt buộc)
NEXT_PUBLIC_URL=http://localhost:3000
URL=http://localhost:3000
NEXT_PUBLIC_EPORTFOLIO_URL=http://localhost:3000

# 4. Google Service Account (Tùy chọn - Dùng khi kết nối Google Drive / Google Sheets)
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 5. Google Gemini AI API Key (Dùng cho các tính năng phân tích Co-pilot & sinh nhận xét AI)
GEMINI_API_KEY=your_gemini_api_key_here
