# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU CHO HỆ THỐNG SYS-AIR (NEXT.JS + MONGODB)
# Sao chép file này thành .env trên máy mới trước khi chạy dự án:
#    cp .env.example .env (hoặc copy .env.example .env trên Windows)
# ==============================================================================

# 1. Kết nối Cơ sở dữ liệu MongoDB (Bắt buộc)
# Chạy MongoDB cục bộ (Local) hoặc MongoDB Atlas Cloud:
MONGODB_URI=mongodb://localhost:27017/sys-air
MongoDB_URI=mongodb://localhost:27017/sys-air

# 2. Cấu hình Bảo mật JWT & Cookie (Bắt buộc)
JWT_SECRET=your_super_secret_jwt_key_here
TOKEN_COOKIE_NAME=token
token=token

# 3. Địa chỉ URL chạy ứng dụng (Bắt buộc)
NEXT_PUBLIC_URL=http://localhost:3000
URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# 4. Zalo Bot Notification (Bắt buộc cho thông báo chuyên cần & cảnh báo vi phạm SLA)
ZALO_BOT_TOKEN=your_zalo_bot_token_here
ZALO_BOT_NAME=Bot 135Tiet
ZALO_BOT_DEFAULT_CHAT_ID=

# 5. Google Service Account (Dùng khi kết nối Google Drive / Google Sheets)
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_here\n-----END PRIVATE KEY-----\n"

# 6. Cấu hình Google Drive Folder IDs (Lưu trữ ảnh đại diện, bìa sách, tài liệu)
GOOGLE_DRIVE_STUDENT_AVT_FOLDER_ID=your_student_avatar_folder_id
GOOGLE_DRIVE_BOOK_FOLDER_ID=your_book_folder_id
GOOGLE_DRIVE_TRIAL_FOLDER_ID=your_trial_folder_id

# 7. Cấu hình Google Spreadsheet IDs (Đồng bộ khách hàng, lịch trình, báo cáo)
GOOGLE_SHEETS_CUSTOMER_ID=your_customer_spreadsheet_id
GOOGLE_SHEETS_CUSTOMER_RANGE=Data!A:G
GOOGLE_SHEETS_CUSTOMER_DATA_RANGE=Data!A:L
GOOGLE_SHEETS_CALENDAR_RE_ID=your_calendar_re_spreadsheet_id
GOOGLE_SHEETS_CALENDAR_RES_ID=your_calendar_res_spreadsheet_id
GOOGLE_SHEETS_ZALO_ACCOUNT_SHEET=Account
DEFAULT_CUSTOMER_SOURCE_ID=your_customer_source_id

# 8. Cấu hình Google Apps Script Web App URLs (Tự động hóa gửi tin & Lịch)
GOOGLE_APPSCRIPT_CALENDAR_URL=https://script.google.com/macros/s/your_calendar_script_id/exec
GOOGLE_APPSCRIPT_SENDMES_URL=https://script.google.com/macros/s/your_sendmes_script_id/exec
GOOGLE_SCRIPT_URL_SEND_MESSAGE=https://script.google.com/macros/s/your_send_message_script_id/exec
GOOGLE_SCRIPT_URL_GET_UID=https://script.google.com/macros/s/your_get_uid_script_id/exec
GOOGLE_SCRIPT_URL_ACTION=https://script.google.com/macros/s/your_action_script_id/exec
GOOGLE_APPS_SCRIPT_ZALO_URL=https://script.google.com/macros/s/your_zalo_script_id/exec
